{
  "name": "clorizon-workspace-qa-framework",
  "version": "1.0.0",
  "description": "Comprehensive QA Framework for Clorizon AI-Augmented Workspace",
  "author": "Segun Omiyedun",
  "license": "MIT",
  "scripts": {
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:component": "jest tests/component",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test",
    "test:performance": "echo 'Performance tests require k6 to be installed separately'",
    "test:security": "echo 'Security tests require additional tools'",
    "test:a11y": "jest tests/accessibility",
    "test:ci": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:all": "npm run test:ci && npm run test:e2e && npm run test:performance",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "report": "allure generate allure-results --clean && allure open"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.34.1",
    "allure-jest": "^2.15.1",
    "allure-playwright": "^2.15.0",
    "axe-core": "^4.8.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.3.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "dotenv": "^16.3.0"
  }
}
